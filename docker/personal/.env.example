# Keep this file next to compose.yaml. After editing it, from this directory:
#   docker compose pull
#   docker compose up -d
# The image is ghcr.io/0x0501/readest:latest.

# Cloud Postgres connection string. If the password contains # or a space, wrap the whole value in single quotes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# openssl rand -hex 32. Reuse the existing BETTER_AUTH_SECRET so current sessions stay valid.
BETTER_AUTH_SECRET=replace-me

# Comma-separated. An address that is not listed cannot register.
SIGNUP_ALLOWED_EMAILS=you@example.com

# The client sends API requests to this address. Better Auth checks the Origin
# against https://read.sumku.cc, baked into the image at build time. Use that same address.
API_BASE_URL=https://read.sumku.cc

OBJECT_STORAGE_TYPE=r2
R2_REGION=auto
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=readest-files
TEMP_STORAGE_PUBLIC_BUCKET_NAME=readest-public

TURNSTILE_SECRET_KEY=replace-me
TURNSTILE_SITE_KEY=replace-me

# Same ceilings as the Worker: 100 GiB of storage, 10485760 translation characters per day.
STORAGE_FIXED_QUOTA=107374182400
TRANSLATION_FIXED_QUOTA=10485760

# Password-reset mail from this container is written to the log. Delivery stays on Cloudflare Email.
# AUTH_EMAIL_FROM=noreply@example.com

# Uncomment both to offer GitHub sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Passkeys bind to read.sumku.cc when this is unset. Another domain invalidates enrolled passkeys.
# PASSKEY_RP_ID=read.sumku.cc

# DEEPL_PRO_API_KEYS=
# DEEPL_FREE_API_KEYS=
# AI_GATEWAY_API_KEY=
# GOOGLE_BOOKS_API_KEYS=
