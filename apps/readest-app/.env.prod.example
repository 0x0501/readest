# Production deployment config. Copy to `.env.prod` and fill in — that file is
# gitignored and holds real credentials.
#
# `pnpm deploy` reads it twice:
#
#   1. the OpenNext build, so every NEXT_PUBLIC_* below is baked into the
#      client bundle;
#   2. `wrangler deploy --secrets-file .env.prod`, so the Worker reads the same
#      values at runtime.
#
# Two rules follow from that:
#
# * Do not repeat anything from `wrangler.toml [vars]` — bucket names,
#   R2_REGION, the quota ceilings. A name bound as both a var and a secret is
#   bound twice and which one wins is not worth relying on.
#
# * Leave an unused key COMMENTED OUT rather than empty. wrangler uploads every
#   key it finds, and the code falls back with `??`, which catches undefined but
#   not `''` — so `NEXT_PUBLIC_SEND_EMAIL_DOMAIN=` gives you an empty domain
#   instead of the default, which is worse than not setting it.
#
# Secrets are never deleted by a deploy: removing a line here leaves the old
# value live on the Worker. Use `wrangler secret delete <NAME>` for that.

# ─── Required: the deployment cannot work without these ──────────────────────

# The origin the Worker is actually served on — the `[[routes]]` pattern in
# wrangler.toml. Better Auth checks the Origin header against it and issues JWTs
# for it, so a wrong value does not degrade gracefully: the site works and every
# single sign-in returns 403 INVALID_ORIGIN, which reads like an auth bug rather
# than a typo. It is also the host baked into share links and deep links.
NEXT_PUBLIC_WEB_BASE_URL=https://read.example.com
NEXT_PUBLIC_API_BASE_URL=https://read.example.com

# Signs sessions and cookies. Better Auth throws on startup in production when
# it is missing or left at its default, so every request 500s. At least 32
# characters: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# The instance's admission gate, comma-separated. Email verification is off
# because this list is what keeps strangers out, so an empty or unset value
# admits NOBODY — including you, on a fresh database. Set it before the first
# deploy or you cannot create your own account.
SIGNUP_ALLOWED_EMAILS=you@example.com

# R2, reached over the S3 API rather than a binding, so it needs real
# credentials. From an R2 API token with Object Read & Write on the buckets named
# in wrangler.toml. Without these the site reads fine and cannot upload a book.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Which storage backend the browser half expects. Must agree with
# OBJECT_STORAGE_TYPE in wrangler.toml.
NEXT_PUBLIC_OBJECT_STORAGE_TYPE=r2

# The address password-reset mail is sent from, through the `send_email` binding
# in wrangler.toml (ADR-016). Its domain must have been onboarded once with
# `wrangler email sending enable <domain>`; anything else fails every send with
# E_SENDER_NOT_VERIFIED. Kept as configuration precisely so that a rejected
# domain is a one-line change rather than a rebuild.
AUTH_EMAIL_FROM=noreply@read.example.com

# Cloudflare Turnstile, protecting sign-in, sign-up and password-reset requests.
# The secret verifies tokens server-side; the site key renders the widget and is
# public by design. Both are required: the captcha plugin is registered only when
# the secret is present, so a deployment missing it is unprotected while looking
# entirely normal. Create the widget in the Cloudflare dashboard with the
# deployment's hostname; local development runs without either key and skips the
# whole layer.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Migrations: read from your machine, not by the Worker ───────────────────

# The Worker reaches Postgres through the Hyperdrive binding and never reads
# this, but `pnpm db:migrate` does. It must be the database's DIRECT connection
# string — not Hyperdrive's, which only resolves inside a Worker, and not a
# transaction pooler, which cannot run DDL. It does get uploaded with the rest;
# that is the cost of keeping one file, and anyone who can read Worker secrets
# can already reach the same database through the binding.
DATABASE_URL=postgresql://user:password@host:5432/readest

# ─── Optional: uncomment only what you actually configure ────────────────────

# The WebAuthn Relying Party ID passkeys are bound to. Left unset it is the
# hostname of NEXT_PUBLIC_WEB_BASE_URL, which is what you want unless the
# passkeys have to cover more than this host. Note that this is the one setting
# here that cannot be corrected later: changing it does not migrate credentials,
# it invalidates them, and every device enrols again (ADR-018).
# PASSKEY_RP_ID=read.example.com

# GitHub sign-in. Both or neither: the sign-in page asks the server whether they
# are configured and hides the button when they are not, so a half-filled pair
# offers a button that can only fail. Callback URL is
# <NEXT_PUBLIC_WEB_BASE_URL>/api/auth/callback/github.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Custom domains on the public R2 bucket. Only the Tauri Discord presence and the
# published-cover path use them; the web app never does. Left commented they fall
# back to readest.com hosts, which are not yours but at least resolve.
# NEXT_PUBLIC_PUBLIC_ASSETS_BASE_URL=
# NEXT_PUBLIC_PUBLIC_STORAGE_BASE_URL=

# Domain for Send to Readest inbound mail. Needs the send-email Worker deployed
# and Cloudflare Email Routing pointed at it.
# NEXT_PUBLIC_SEND_EMAIL_DOMAIN=

# Translation and AI providers. Each is independent — the app falls back to its
# free or built-in path for whichever is absent.
# DEEPL_PRO_API_KEYS=
# DEEPL_FREE_API_KEYS=
# AI_GATEWAY_API_KEY=
# GOOGLE_BOOKS_API_KEYS=
